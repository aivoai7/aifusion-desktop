# 复制成 .env 再填；.env 必须在 .gitignore 里。
# 这里只放占位符，任何真实密钥都不进仓库、不进日志、不进截图。

POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me

# 上游渠道的 Key 由部署环境注入，数据库 channels.secret_ref 只存引用名
CHANNEL_OPENAI_KEY=
CHANNEL_ANTHROPIC_KEY=

# 占位网关（PassthroughForwarder）打到哪儿；真网关按 channels 表选路，不读这个
UPSTREAM_BASE_URL=

# 对外域名，Caddyfile 里要改成同一个
PLATFORM_DOMAIN=platform.example.com
